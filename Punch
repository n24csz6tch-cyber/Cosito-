local function makeBtn(text, order)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-6,0,34); b.BackgroundColor3 = Color3.fromRGB(40,40,52)
    b.BorderSizePixel = 0; b.Text = text; b.TextColor3 = Color3.fromRGB(225,225,235)
    b.Font = Enum.Font.GothamMedium; b.TextSize = 13; b.LayoutOrder = order; b.Parent = scroll
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,7)
    return b
end

local function addToggle(name, order, key)
    local b = makeBtn(name..": OFF", order)
    b.MouseButton1Click:Connect(function()
        state[key] = not state[key]
        if state[key] then
            b.Text = name..": ON"; b.BackgroundColor3 = Color3.fromRGB(0,150,90)
        else
            b.Text = name..": OFF"; b.BackgroundColor3 = Color3.fromRGB(40,40,52)
        end
    end)
end


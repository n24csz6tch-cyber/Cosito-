local function showDiag()
    pcall(scanRemotes, RS)
    local list = {}
    local function walk(o)
        for _, c in ipairs(o:GetChildren()) do
            if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
                table.insert(list, "["..c.ClassName.."] "..getFullPath(c))
            end
            if c:IsA("Folder") or c:IsA("Model") or c:IsA("Configuration") then walk(c) end
        end
    end
    walk(RS)

    local f = Instance.new("Frame")
    f.Size = UDim2.new(0,300,0,400); f.Position = UDim2.new(0.5,-150,0.5,-200)
    f.BackgroundColor3 = Color3.fromRGB(12,12,16); f.Parent = gui
    Instance.new("UICorner", f).CornerRadius = UDim.new(0,10)

    local sf = Instance.new("ScrollingFrame")
    sf.Size = UDim2.new(1,-16,1,-60); sf.Position = UDim2.new(0,8,0,48)
    sf.BackgroundTransparency = 1; sf.ScrollBarThickness = 4
    sf.CanvasSize = UDim2.new(0,0,0,#list*18+20); sf.Parent = f

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,-8,0,#list*18+20); lbl.Position = UDim2.new(0,4,0,0)
    lbl.BackgroundTransparency = 1; lbl.Text = table.concat(list,"\n")
    lbl.TextColor3 = Color3.fromRGB(180,255,200); lbl.Font = Enum.Font.Code
    lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Top; lbl.Parent = sf

    local h = Instance.new("TextLabel")
    h.Size = UDim2.new(1,0,0,40); h.BackgroundTransparency = 1
    h.Text = "DIAGNOSTICO ("..#list.." remotes)"; h.TextColor3 = Color3.new(1,1,1)
    h.Font = Enum.Font.GothamBold; h.TextSize = 14; h.Parent = f

    local cb = Instance.new("TextButton")
    cb.Size = UDim2.new(1,-16,0,30); cb.Position = UDim2.new(0,8,1,-38)
    cb.BackgroundColor3 = Color3.fromRGB(180,50,50); cb.Text = "CERRAR"
    cb.TextColor3 = Color3.new(1,1,1); cb.Font = Enum.Font.GothamBold; cb.Parent = f
    cb.MouseButton1Click:Connect(function() f:Destroy() end)
end


local function notif(t)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification",
            {Title="Venice Punch", Text=tostring(t), Duration=3})
    end)
end

local function W(root, ...)
    local o = root
    for _, n in ipairs({...}) do
        if not o then return nil end
        local c = o:FindFirstChild(n) or o:WaitForChild(n, 5)
        o = c
    end
    return o
end


--==================== INDICE DE REMOTES ====================
local remotes = {}
local function scanRemotes(obj)
    for _, c in ipairs(obj:GetChildren()) do
        if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
            remotes[c.Name:lower()] = c
        end
        if c:IsA("Folder") or c:IsA("Model") or c:IsA("Configuration") then
            scanRemotes(c)
        end
    end
end
pcall(scanRemotes, RS)

local function getRemote(...)
    local names = {...}
    for _, n in ipairs(names) do
        local r = remotes[n:lower()]
        if r then return r end
    end
    for _, n in ipairs(names) do
        local key = n:lower()
        for rn, r in pairs(remotes) do
            if rn:find(key, 1, true) then return r end
        end
    end
    return nil
end

local function fire(r, ...)
    if not r then return end
    if r:IsA("RemoteEvent") then r:FireServer(...)
    else r:InvokeServer(...) end
end

local function getFullPath(obj)
    local parts, o = {}, obj
    while o and o ~= game do
        table.insert(parts, 1, o.Name); o = o.Parent
    end
    return table.concat(parts, ".")
end


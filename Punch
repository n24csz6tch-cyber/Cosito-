local Events = RS:WaitForChild("Events", 30)

-- Estado de funciones
local S = {
	autoPunch=false, autoHatch=false, autoUGC=false,
	autoRebirth=false, autoChest=false, autoCoins=false,
	autoDungeon=false, infJump=false, speed=16,
}

--========================= HELPERS =========================
local function safeRemote(name)
	local r = Events and Events:FindFirstChild(name)
	if r and r:IsA("RemoteEvent") then return r end
	return nil
end

-- Busca un remote por palabras clave en su nombre (anti-bug)
local function fuzzyRemote(...)
	if not Events then return nil end
	local keys = {...}
	for _, c in ipairs(Events:GetChildren()) do
		if c:IsA("RemoteEvent") then
			local n = string.lower(c.Name)
			for _, k in ipairs(keys) do
				if string.find(n, k, 1, true) then return c end
			end
		end
	end
	return nil
end

--========================= REMOTES =========================
local rPunch   = safeRemote("DamageIncreaseOnClickEvent")
local rEgg     = safeRemote("PlayerPressedKeyOnEgg")
local rPush    = safeRemote("PushEvent")

local rUGC     = fuzzyRemote("ugc","claim","gift","reward","daily")
local rRebirth = fuzzyRemote("rebirth","ascend","prestige")
local rChest   = fuzzyRemote("chest","hidden")
local rCoins   = fuzzyRemote("coin","free")
local rDungeon = fuzzyRemote("dungeon","start","enter")

--========================= CHARACTER =======================
local char, hum, root
local function bindChar(c)
	char = c
	hum  = c:WaitForChild("Humanoid")
	root = c:WaitForChild("HumanoidRootPart")
end
if LP.Character then bindChar(LP.Character) end
LP.CharacterAdded:Connect(bindChar)

--========================= LOOPS ===========================
-- Auto Punch
task.spawn(function()
	while true do
		local dt = task.wait()
		if S.autoPunch and rPunch then
			pcall(function() rPunch:FireServer() end)
		end
	end
end)

-- Auto Hatch (cicla teclas a-z al remote del huevo)
task.spawn(function()
	local keys = {}
	for c in string.gmatch("abcdefghijklmnopqrstuvwxyz", ".") do keys[#keys+1] = c end
	local i = 1
	while true do
		task.wait(0.1)
		if S.autoHatch and rEgg then
			pcall(function() rEgg:FireServer(keys[i]) end)
			i = (i % #keys) + 1
		end
	end
end)

-- Auto Claim UGC (lo mas importante)
task.spawn(function()
	while true do
		task.wait(1)
		if S.autoUGC and rUGC then
			pcall(function() rUGC:FireServer() end)
		end
	end
end)

-- Auto Rebirth / Chest / Coins / Dungeon
task.spawn(function()
	while true do
		task.wait(1.5)
		if S.autoRebirth and rRebirth then pcall(function() rRebirth:FireServer() end) end
		if S.autoChest   and rChest   then pcall(function() rChest:FireServer() end)   end
		if S.autoCoins   and rCoins   then pcall(function() rCoins:FireServer() end)   end
		if S.autoDungeon and rDungeon then pcall(function() rDungeon:FireServer() end) end
	end
end)

-- Infinite Jump

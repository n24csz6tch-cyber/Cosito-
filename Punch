--==================== CLICK DE BOTONES UGC ====================
local function clickClaim()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible then
            local s = ((d.Text or "").." "..d.Name):lower()
            if s:find("claim",1,true) and
              (s:find("ugc",1,true) or s:find("free",1,true) or s:find("gift",1,true) or s:find("reward",1,true)) then
                pcall(function() d:Activate() end)
            end
        end
    end
end

